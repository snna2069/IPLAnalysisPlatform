# Copy to .streamlit/secrets.toml for local development.
# Never commit real credentials.
SNOWFLAKE_ACCOUNT = "your_account_identifier"
SNOWFLAKE_USER = "your_read_only_user"
SNOWFLAKE_PASSWORD = "your_password"
SNOWFLAKE_ROLE = "your_reporting_role"
SNOWFLAKE_WAREHOUSE = "IPL_ANALYTICS_WH"
SNOWFLAKE_DATABASE = "IPL_ANALYTICS"
SNOWFLAKE_SCHEMA = "ANALYTICS"