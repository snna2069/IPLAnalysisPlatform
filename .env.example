# Copy this file to .env for local development; never commit real credentials.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=IPL_ANALYTICS_WH
SNOWFLAKE_DATABASE=IPL_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=your_role

# JSON mapping of dataset names to source URLs. Cricsheet is a public IPL
# source; use its IPL JSON download or another compatible CSV/JSON endpoint.
IPL_SOURCE_URLS={"matches":"https://cricsheet.org/downloads/ipl_json.zip"}
IPL_DATA_DIR=data
IPL_RAW_DIR=data/raw
IPL_PROCESSED_DIR=data/processed
IPL_REQUIRED_COLUMNS={}
IPL_REQUEST_TIMEOUT=30
IPL_RETRY_ATTEMPTS=3

# Airflow runs manually by default. Set this to a preset such as @daily to enable scheduling.
IPL_AIRFLOW_SCHEDULE=
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=airflow@example.com
